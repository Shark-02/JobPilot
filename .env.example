APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot

LLM_BASE_URL=https://xxx.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-flash
LLM_CONTEXT_WINDOW=131072
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2

# One-time baseline profile bootstrap only; keep original values when migrating existing vectors.
# Online model/dimension come from the database Active Profile, never from these values.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_TOKENIZER_ENCODING=o200k_base
BGE_M3_API_KEY=

AGENT_MAX_MODEL_TURNS=12
AGENT_MAX_TOOL_EXECUTIONS=20
AGENT_MODEL_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=60
AGENT_TOTAL_DEADLINE_SECONDS=300

CORE_PROFILE_MAX_TOKENS=1200
RECENT_CONVERSATION_TARGET_TOKENS=12000
RECENT_CONVERSATION_MAX_TOKENS=20000
# Omit to preserve min(48000, hard_input_limit * 0.70).
# CONTEXT_EVICTION_TRIGGER_TOKENS=48000
RECENT_RAW_RUNTIME_KEEP_COUNT=1
WORKING_TASK_STATE_MAX_TOKENS=6000
CONTEXT_SAFETY_MARGIN_TOKENS=4096

KNOWLEDGE_DEFAULT_MAX_MODULES=6
KNOWLEDGE_MAX_MODULES=16
KNOWLEDGE_DEFAULT_MAX_TOKENS=8000
KNOWLEDGE_MAX_TOKENS=24000

TRACE_ENABLED=true
TRACE_RETENTION_DAYS=30

MODEL_EGRESS_PREVIEW_ENABLED=true
MODEL_EGRESS_PREVIEW_STORE_CONTENT=false
MODEL_EGRESS_PREVIEW_MAX_CHARS=30000

# Offline evaluation: this must be a database distinct from DATABASE_URL.
# Corpus is read from DATABASE_URL (or EVAL_SOURCE_DATABASE_URL) and copied after SHA-256 verification.
EVAL_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot_eval
EVAL_SOURCE_DATABASE_URL=
# Omit these to use the main LLM provider as the structured evaluation judge.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_TEMPERATURE=0.0
EVAL_JUDGE_TIMEOUT_SECONDS=600
EVAL_JUDGE_MAX_OUTPUT_TOKENS=8192
